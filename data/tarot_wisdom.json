[\n  {\n    \"id\": \"tarot_001\",\n    \"category\": \"meaning\",\n    \"question\": \"What does the Tarot reveal about our nature and the circumstances of our lives?\",\n    \"perspective\": \"The Tarot is our hand revealed. The material and circumstances in life is ourselves. So when you hear of this or there is something in Life, it is of us. The Tarot, a showcasing of one's hand. An elaboration of ourselves. The deck, consisting of the community, is our thoughts, our actions, and our events.\",\n    \"themes\": [\"self-knowledge\", \"reflection\", \"identity\", \"fate\", \"interconnection\", \"community\"],\n    \"image_prompts\": [\n      \"An open hand holding tarot cards, reflecting infinite depths\",\n      \"A mirror showing not just reflection but intricate patterns of thought and action\",\n      \"Tarot cards arranged in a circle, each representing thoughts, actions, and events\",\n      \"A figure gazing into a mirror that reveals their inner landscape\",\n      \"Cards radiating from a central point, symbolizing self at the center of existence\"\n    ],\n    \"metadata\": {\n      \"difficulty\": \"advanced\",\n      \"philosophical_school\": \"existentialism, introspection, mysticism\",\n      \"keywords\": [\"tarot\", \"self-knowledge\", \"identity\", \"reflection\", \"fate\", \"hand\", \"community\", \"introspection\"],\n      \"created_date\": \"2026-06-04\",\n      \"contributor\": \"TrainPassenger\"\n    }\n  },\n  {\n    \"id\": \"tarot_002\",\n    \"category\": \"consciousness\",\n    \"question\": \"How can we see ourselves truly and understand the intricate experience that we are?\",\n    \"perspective\": \"The Tarot is about knowing yourself. Seeing your fate. Your hand, set before you. Your identity, being revealed. A moment to look at a mirror, and accurately see the intricate experience that you are. An unstill reflection of you.\",\n    \"themes\": [\"self-awareness\", \"consciousness\", \"identity\", \"introspection\", \"truth\", \"authenticity\"],\n    \"image_prompts\": [\n      \"A living mirror that shifts and moves, revealing deeper layers of self\",\n      \"An unstill reflection in water, capturing the dynamic nature of identity\",\n      \"Light illuminating the complex patterns of one's inner world\",\n      \"A figure seeing themselves clearly for the first time\",\n      \"Layers of transparent glass reflecting infinite facets of self\"\n    ],\n    \"metadata\": {\n      \"difficulty\": \"advanced\",\n      \"philosophical_school\": \"phenomenology, introspection, consciousness studies\",\n      \"keywords\": [\"consciousness\", \"self-awareness\", \"identity\", \"reflection\", \"authenticity\", \"introspection\"],\n      \"created_date\": \"2026-06-04\",\n      \"contributor\": \"TrainPassenger\"\n    }\n  },\n  {\n    \"id\": \"tarot_003\",\n    \"category\": \"existential\",\n    \"question\": \"What is the relationship between asking and knowing, between inquiry and artistry?\",\n    \"perspective\": \"To ask, is the graceful process of knowing. The artistry, is the answer being poetic. A song, playing for you, wrote for you.\",\n    \"themes\": [\"inquiry\", \"knowledge\", \"artistry\", \"grace\", \"truth\", \"beauty\", \"expression\"],\n    \"image_prompts\": [\n      \"A song materializing as visible light or form\",\n      \"Questions transforming into beautiful poetic answers\",\n      \"A graceful dance between inquiry and understanding\",\n      \"Music written in the form of wisdom and revelation\",\n      \"A symphony of questions and answers flowing together\"\n    ],\n    \"metadata\": {\n      \"difficulty\": \"advanced\",\n      \"philosophical_school\": \"epistemology, aesthetics, poetics\",\n      \"keywords\": [\"inquiry\", \"knowledge\", \"artistry\", \"grace\", \"poetry\", \"beauty\", \"truth\"],\n      \"created_date\": \"2026-06-04\",\n      \"contributor\": \"TrainPassenger\"\n    }\n  }\n]\n"